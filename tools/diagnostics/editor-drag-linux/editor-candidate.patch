+    /// Narrow observer for the drag latency harness; does not make host calls.
+    pub fn frame_stream_diagnostics(&self) -> serde_json::Value {
+        let queue_stats = |stats: orr_remote::link::QueueStats| {
+            json!({
+                "limits": { "max_items": stats.limits.max_items, "max_bytes": stats.limits.max_bytes },
+                "current_items": stats.current_items,
+                "current_bytes": stats.current_bytes,
+                "peak_items": stats.peak_items,
+                "peak_bytes": stats.peak_bytes,
+                "saturations": stats.saturations,
+                "closed": stats.closed,
+            })
+        };
+        let (transport, metrics) = match &self.backend.bridge {
+            EditorStream::Phys(bridge) => (bridge.transport_queue_stats(), bridge.metrics()),
+            EditorStream::Arena(bridge) => (bridge.transport_queue_stats(), bridge.metrics()),
+        };
+        json!({
+            "transport_queues": match transport {
+                Some(stats) => json!({
+                    "available": true,
+                    "outgoing": queue_stats(stats.outgoing),
+                    "incoming": queue_stats(stats.incoming),
+                }),
+                None => json!({ "available": false, "reason": "transport_stats_unavailable", "outgoing": null, "incoming": null }),
+            },
+            "frame_metrics": {
+                "frames": metrics.frames,
+                "frame_bytes": metrics.frame_bytes,
+                "last_frame_bytes": metrics.last_frame_bytes,
+                "last_frame_raw_bytes": metrics.last_frame_raw_bytes,
+                "last_latency_us": metrics.last_latency_us,
+                "max_latency_us": metrics.max_latency_us,
+                "latency_sum_us": metrics.latency_sum_us,
+                "last_decode_us": metrics.last_decode_us,
+            },
+        })
+    }
+
     pub(crate) fn record_ui_frame(&mut self, elapsed: Duration) {
         self.telemetry.ui_frame.record(elapsed);
     }
