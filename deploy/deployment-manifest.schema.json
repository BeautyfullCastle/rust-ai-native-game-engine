{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:orrery:deployment-manifest:1",
  "title": "Orrery deployment manifest v1",
  "description": "Structural guidance only. tools/deployment_manifest.py is authoritative: it validates the u64 bounds, exact JSON lexical types, and build_id == frame_build_id(game_code_id, frame_format_version). The schema cannot express that derived-id relationship, and JSON Schema treats 2.0 as an integer even though the manifest tool requires the JSON integer token 2. Provenance is informational and is not an attestation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "game",
    "game_code_identity",
    "game_code_id",
    "frame_format_version",
    "build_id",
    "provenance"
  ],
  "properties": {
    "format": { "const": "orr.deployment/1" },
    "game": { "enum": ["arena", "physics"] },
    "game_code_identity": { "type": "string", "minLength": 1, "pattern": "^\\S(?:.*\\S)?$" },
    "game_code_id": { "$ref": "#/$defs/nonzeroU64" },
    "frame_format_version": { "const": 2 },
    "build_id": { "$ref": "#/$defs/nonzeroU64" },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_revision", "binaries"],
      "properties": {
        "source_revision": { "type": ["string", "null"], "minLength": 1, "pattern": "^\\S(?:.*\\S)?$" },
        "binaries": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "sha256"],
            "properties": {
              "label": { "type": "string", "minLength": 1, "pattern": "^\\S(?:.*\\S)?$" },
              "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "nonzeroU64": {
      "type": "string",
      "pattern": "^(?:[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|1844674407370955[0-0][0-9]{3}|18446744073709551[0-5][0-9]{2}|184467440737095516[0-0][0-9]{1}|1844674407370955161[0-4]|18446744073709551615)$",
      "description": "Canonical positive decimal u64 string. The Python validator remains authoritative for the derived build_id relationship and exact JSON token types."
    }
  }
}
